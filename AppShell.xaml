<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MailMessenger.Client.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MailMessenger.Client.Views"
    FlyoutBehavior="Disabled"
    Title="MailMessenger"
    Shell.NavBarHasShadow="False"
    Shell.BackgroundColor="#0D0D0D"
    Shell.ForegroundColor="#FFFFFF"
    Shell.TitleColor="#FFFFFF">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="login" />

    <ShellContent
        Title="Messages"
        ContentTemplate="{DataTemplate views:ContactsPage}"
        Route="contacts" />

</Shell>
